{
  "name": "corneriq",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/api-server --filter @workspace/corneriq run --parallel dev",
