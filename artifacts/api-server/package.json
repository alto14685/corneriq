{
  "name": "@workspace/api-server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "@workspace/db": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.0",
    "express": "^5.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
